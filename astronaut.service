[Unit]
Description=Astronaut push-to-talk Mission Control
# No network-online wait: the app starts offline and says "comms online" when connected.
After=sound.target
# Never give up restarting (default limit would stop after 5 quick failures)
StartLimitIntervalSec=0

[Service]
Type=simple
User=landers2
SupplementaryGroups=audio gpio
WorkingDirectory=/home/landers2/astronaut-speaker
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/landers2/astronaut-speaker/.venv/bin/python main.py
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
